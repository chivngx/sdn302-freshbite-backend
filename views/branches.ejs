<%- include('partials/header') %>

<div class="workspace-hero">
  <div class="hero-text-block">
    <div class="hero-tag">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
      <span>MẠNG LƯỚI BÁN LẺ & TRẠM VẬN HÀNH</span>
    </div>
    <h1 class="hero-heading">Hệ Thống Chi Nhánh FreshBite Đà Nẵng</h1>
    <p class="hero-subheading">4 chi nhánh hoạt động tại các quận trung tâm và ven biển Đà Nẵng</p>
  </div>
  
  <div class="hero-actions">
    <a href="/admin/orders" class="btn btn-primary">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"></rect><path d="M6 2v4"></path><path d="M18 2v4"></path></svg>
      <span>Xem Đơn Hàng Theo Chi Nhánh</span>
    </a>
  </div>
</div>

<div class="branches-cards-grid">
  <% if (branches && branches.length > 0) { %>
    <% branches.forEach(branch => { %>
      <div class="store-card">
        <div class="store-image-stage">
          <img src="<%= branch.imageUrl || 'https://images.unsplash.com/photo-1554118811-1e0d58224f24?w=800' %>" 
               alt="<%= branch.name %>" class="store-cover-img">
          <div class="store-district-overlay">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"></polygon></svg>
            <span><%= branch.district %></span>
          </div>
        </div>

        <div class="store-body">
          <div class="store-title-row">
            <h3 class="store-name"><%= branch.name %></h3>
            <span class="store-status-pill <%= branch.isActive ? 'status-open' : 'status-closed' %>">
              <% if (branch.isActive) { %>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Đang Mở Cửa</span>
              <% } else { %>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line></svg>
                <span>Tạm Nghỉ</span>
              <% } %>
            </span>
          </div>

          <p class="store-address">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-shrink-0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <span><%= branch.address %></span>
          </p>

          <div class="store-specs-list">
            <div class="store-spec-item">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              <span><%= branch.phone || '0236.730.0999' %></span>
            </div>
            <div class="store-spec-item">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              <span><%= branch.openingHours || '06:30 - 22:30' %></span>
            </div>
          </div>

          <div class="store-gps-block">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon></svg>
            <span>Tọa độ GPS: <code><%= branch.latitude %>, <%= branch.longitude %></code></span>
          </div>

          <div class="store-actions-bar">
            <a href="/admin/orders?branchId=<%= branch._id %>" class="btn-store-kds">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"></rect><path d="M6 2v4"></path><path d="M18 2v4"></path></svg>
              <span>Mở Màn Hình KDS Trạm Này</span>
            </a>
          </div>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <div class="empty-cell">
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="empty-svg"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
      <p>Chưa có dữ liệu chi nhánh. Hãy chạy lệnh <code>npm run seed:branches</code> hoặc <code>npm run seed:all</code>!</p>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
