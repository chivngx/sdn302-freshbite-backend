<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'FreshBite Specialty Coffee & Tea - Chuỗi Cửa Hàng & KDS' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/style.css">
  <script src="/socket.io/socket.io.js"></script>
</head>
<body class="freshbite-app">
  <div class="m3-shell-wrapper">
    <!-- Left Navigation Sidebar -->
    <aside class="m3-sidebar">
      <div>
        <!-- Brand Identity Lockup -->
        <a href="/admin/dashboard" class="sidebar-brand-lockup">
          <div class="brand-emblem-badge">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
              <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
              <line x1="6" y1="1" x2="6" y2="4"></line>
              <line x1="10" y1="1" x2="10" y2="4"></line>
              <line x1="14" y1="1" x2="14" y2="4"></line>
            </svg>
          </div>
          <div class="brand-text-block">
            <span class="brand-title">FreshBite</span>
            <span class="brand-subtitle">Coffee & Tea</span>
          </div>
        </a>

        <!-- Main Navigation Pills -->
        <div class="nav-section-label">HỆ THỐNG</div>
        <nav class="sidebar-nav-menu">
          <a href="/admin/dashboard" class="m3-nav-pill <%= (typeof activeTab !== 'undefined' && activeTab === 'dashboard') || (typeof title !== 'undefined' && (title.includes('Bảng Quản Trị') || title.includes('Doanh Thu'))) ? 'active' : '' %>">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
              <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
              <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
              <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
            </svg>
            <span>Bảng Quản Trị</span>
          </a>

          <a href="/admin/orders" class="m3-nav-pill <%= (typeof activeTab !== 'undefined' && activeTab === 'orders') || (typeof title !== 'undefined' && (title.includes('KDS') || title.includes('Barista'))) ? 'active' : '' %>">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="6" width="20" height="12" rx="2"></rect>
              <path d="M6 2v4"></path>
              <path d="M18 2v4"></path>
            </svg>
            <span>Trạm Barista KDS</span>
            <span class="kds-live-pill">LIVE</span>
          </a>

          <a href="/admin/products" class="m3-nav-pill <%= (typeof activeTab !== 'undefined' && activeTab === 'products') || (typeof title !== 'undefined' && (title.includes('Thực Đơn') || title.includes('Món Ăn'))) ? 'active' : '' %>">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
            <span>Quản Lý Món Ăn</span>
          </a>

          <a href="/admin/chats" class="m3-nav-pill <%= (typeof activeTab !== 'undefined' && activeTab === 'chats') || (typeof title !== 'undefined' && title.includes('CSKH')) ? 'active' : '' %>">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            <span>Live Chat CSKH</span>
            <span class="kds-live-pill" style="background: #2D5A43;">CHAT</span>
          </a>

          <a href="/admin/reviews" class="m3-nav-pill <%= (typeof activeTab !== 'undefined' && activeTab === 'reviews') || (typeof title !== 'undefined' && title.includes('Đánh Giá')) ? 'active' : '' %>">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            <span>Đánh Giá Món</span>
          </a>

          <a href="/admin/reports" class="m3-nav-pill <%= (typeof activeTab !== 'undefined' && activeTab === 'reports') || (typeof title !== 'undefined' && (title.includes('Đối Soát') || title.includes('Báo Cáo'))) ? 'active' : '' %>">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="20" x2="18" y2="10"></line>
              <line x1="12" y1="20" x2="12" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
            <span>Đối Soát Ca Quầy</span>
          </a>

          <a href="/admin/vouchers" class="m3-nav-pill <%= (typeof activeTab !== 'undefined' && activeTab === 'vouchers') || (typeof title !== 'undefined' && title.includes('Voucher')) ? 'active' : '' %>">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="5" width="20" height="14" rx="2"></rect>
              <line x1="2" y1="10" x2="22" y2="10"></line>
            </svg>
            <span>Quản Lý Voucher</span>
          </a>

          <a href="/admin/branches" class="m3-nav-pill <%= (typeof activeTab !== 'undefined' && activeTab === 'branches') || (typeof title !== 'undefined' && title.includes('Chi Nhánh')) ? 'active' : '' %>">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            <span>Chi Nhánh</span>
          </a>
        </nav>

        <div class="nav-section-label" style="margin-top: 10px;">TIỆN ÍCH</div>
        <nav class="sidebar-nav-menu">
          <a href="/api/uploads/template/product-import" class="m3-nav-pill" title="Tải mẫu CSV thực đơn">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Tải Mẫu CSV</span>
          </a>

          <a href="/api/health" target="_blank" class="m3-nav-pill" title="API Status">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
            <span>API Status: 200 OK</span>
          </a>

          <a href="/admin/logout" class="m3-nav-pill" style="color: #991B1B;" title="Đăng Xuất Khỏi Hệ Thống">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span>Đăng Xuất Phiên</span>
          </a>
        </nav>
      </div>

      <!-- Minimal Shift & Status Strip -->
      <div class="sidebar-footer-card">
        <div class="station-badge">
          <span class="status-dot-live"></span>
          <span>Đà Nẵng Central</span>
        </div>
        <span style="font-size: 0.72rem; color: var(--md-sys-color-on-surface-variant); font-family: var(--font-mono); font-weight: 600;">
          06:30 - 23:00
        </span>
      </div>
    </aside>

    <!-- Main Content Stage Area -->
    <div class="m3-main-stage">
      <!-- Top App Bar -->
      <header class="m3-top-appbar">
        <div class="appbar-left-group">
          <div class="appbar-search-pill">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" placeholder="Tìm kiếm đơn, thức uống..." class="appbar-search-input">
          </div>
        </div>

        <div class="appbar-right-group">
          <div class="branch-selector-pill">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>4 Chi Nhánh Đà Nẵng</span>
          </div>

          <div class="user-profile-pill">
            <div class="user-avatar-circle">
              <%= (typeof currentUser !== 'undefined' && currentUser && currentUser.fullName) ? currentUser.fullName.substring(0, 2).toUpperCase() : 'AD' %>
            </div>
            <span class="user-name">
              <%= (typeof currentUser !== 'undefined' && currentUser && currentUser.fullName) ? currentUser.fullName : 'Quản Trị Viên' %>
            </span>
            <a href="/admin/logout" title="Đăng Xuất Khỏi Hệ Thống" style="margin-left: 4px; display: flex; align-items: center; color: var(--md-sys-color-on-surface-variant);">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            </a>
          </div>
        </div>
      </header>

      <!-- Toast Alerts for Actions -->
      <% if (typeof successMsg !== 'undefined' && successMsg) { %>
        <div class="m3-toast-alert toast-success">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span><%= successMsg %></span>
        </div>
      <% } %>
      <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
        <div class="m3-toast-alert toast-error">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          <span><%= errorMsg %></span>
        </div>
      <% } %>

      <!-- Floating Island Main Stage -->
      <main class="m3-floating-island">
