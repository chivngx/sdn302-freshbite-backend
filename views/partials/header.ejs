<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'FreshBite Coffee Chain Management & Barista KDS' %></title>
  
  <!-- Modern Clean Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="freshbite-app">
  <!-- Top Navigation Header -->
  <header class="app-header">
    <div class="header-inner">
      <!-- Brand Logo -->
      <a href="/admin/dashboard" class="brand-link">
        <div class="brand-symbol">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
            <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
            <line x1="6" y1="1" x2="6" y2="4"></line>
            <line x1="10" y1="1" x2="10" y2="4"></line>
            <line x1="14" y1="1" x2="14" y2="4"></line>
          </svg>
        </div>
        <div class="brand-titles">
          <span class="brand-name">FreshBite</span>
          <span class="brand-tagline">ĐÀ NẴNG COFFEE CHAIN</span>
        </div>
      </a>

      <!-- Navigation Links -->
      <nav class="nav-cluster">
        <a href="/admin/dashboard" class="nav-item <%= (typeof title !== 'undefined' && title.includes('Bảng Quản Trị')) ? 'active' : '' %>">
          <svg class="nav-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          <span>Bảng Quản Trị</span>
        </a>

        <a href="/admin/orders" class="nav-item nav-kds <%= (typeof title !== 'undefined' && title.includes('KDS')) ? 'active' : '' %>">
          <svg class="nav-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 2v20"></path>
            <path d="M18 2v20"></path>
            <rect x="2" y="6" width="20" height="12" rx="2"></rect>
          </svg>
          <span>Màn Hình KDS Barista</span>
          <span class="kds-live-chip">LIVE</span>
        </a>

        <a href="/admin/products" class="nav-item <%= (typeof title !== 'undefined' && title.includes('Thực Đơn')) ? 'active' : '' %>">
          <svg class="nav-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
          </svg>
          <span>Quản Lý Món Ăn</span>
        </a>

        <a href="/admin/branches" class="nav-item <%= (typeof title !== 'undefined' && title.includes('Chi Nhánh')) ? 'active' : '' %>">
          <svg class="nav-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          <span>Chi Nhánh Cửa Hàng</span>
        </a>

        <a href="/api/health" target="_blank" class="nav-item nav-health" title="Kiểm tra hệ thống API">
          <span class="pulse-indicator"></span>
          <span>API 200 OK</span>
        </a>
      </nav>

      <!-- Shift Badge -->
      <div class="shift-info">
        <svg class="shift-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <div class="shift-text">
          <span class="shift-title">Ca Hoạt Động</span>
          <span class="shift-time">06:30 - 23:00</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Canvas Container -->
  <main class="app-canvas">
