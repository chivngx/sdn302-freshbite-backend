<%- include('partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">🍰 Quản Lý Thực Đơn & Món Ăn</h1>
    <p class="page-subtitle">Danh mục thức uống đặc sản Đà Nẵng, bánh thủ công và giá theo size (Slot 7 & Slot 12)</p>
  </div>
  <div class="header-actions">
    <a href="/api/uploads/template/product-import" class="btn btn-secondary">📥 Tải Mẫu CSV Thực Đơn</a>
  </div>
</div>

<!-- Upload Test Card (Multer Slot 12 Demo) -->
<div class="card mb-4">
  <div class="card-header">
    <h2 class="card-title">📤 Tải Lên Ảnh Món Ăn (Multer Multipart Demo)</h2>
  </div>
  <div class="card-body">
    <form action="/api/uploads/single" method="POST" enctype="multipart/form-data" target="_blank" class="upload-form">
      <div class="upload-input-group">
        <label for="imageUpload">Chọn ảnh từ máy (JPEG, PNG, WEBP, tối đa 5MB):</label>
        <input type="file" name="image" id="imageUpload" accept="image/*" required class="form-file">
      </div>
      <button type="submit" class="btn btn-primary">🚀 Tải Lên Thư Mục /uploads</button>
      <small class="upload-note">* Tệp sẽ được lưu vào thư mục tĩnh <code>/uploads</code> và có thể truy cập qua URL trực tiếp.</small>
    </form>
  </div>
</div>

<!-- Bảng Danh Sách Món Ăn -->
<div class="card">
  <div class="card-header">
    <h2 class="card-title">📋 Danh Sách Sản Phẩm (<%= products ? products.length : 0 %> món)</h2>
  </div>
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>Hình Ảnh</th>
          <th>Tên Món Ăn</th>
          <th>Danh Mục</th>
          <th>Giá Tiêu Chuẩn</th>
          <th>Giá Theo Size (S / M / L)</th>
          <th>Calo</th>
          <th>Trạng Thái</th>
          <th>Hành Động</th>
        </tr>
      </thead>
      <tbody>
        <% if (products && products.length > 0) { %>
          <% products.forEach(prod => { %>
            <tr>
              <td>
                <img src="<%= prod.imageUrl || 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=200' %>" 
                     alt="<%= prod.name %>" class="prod-thumb">
              </td>
              <td>
                <strong><%= prod.name %></strong>
                <% if (prod.isBestSeller) { %>
                  <span class="badge-bestseller">⭐ Bán chạy</span>
                <% } %>
                <div class="prod-desc"><%= prod.description || '' %></div>
              </td>
              <td>
                <span class="category-pill"><%= (prod.categoryId && prod.categoryId.name) || 'Khác' %></span>
              </td>
              <td>
                <strong class="price-text"><%= Number(prod.price || 0).toLocaleString('vi-VN') %>đ</strong>
              </td>
              <td>
                <% if (prod.sizePricing && (prod.sizePricing.S || prod.sizePricing.M || prod.sizePricing.L)) { %>
                  <div class="size-pricing-chips">
                    <% if (prod.sizePricing.S) { %><span>S: <%= Number(prod.sizePricing.S).toLocaleString('vi-VN') %>đ</span><% } %>
                    <% if (prod.sizePricing.M) { %><span>M: <%= Number(prod.sizePricing.M).toLocaleString('vi-VN') %>đ</span><% } %>
                    <% if (prod.sizePricing.L) { %><span>L: <%= Number(prod.sizePricing.L).toLocaleString('vi-VN') %>đ</span><% } %>
                  </div>
                <% } else { %>
                  <span class="text-muted">Một cỡ duy nhất</span>
                <% } %>
              </td>
              <td><%= prod.calories || 0 %> kcal</td>
              <td>
                <% if (prod.isAvailable) { %>
                  <span class="badge badge-completed">🟢 Còn hàng</span>
                <% } else { %>
                  <span class="badge badge-cancelled">🔴 Tạm hết</span>
                <% } %>
              </td>
              <td>
                <form action="/admin/products/<%= prod._id %>/toggle" method="POST" class="inline-form">
                  <button type="submit" class="btn-sm <%= prod.isAvailable ? 'btn-outline' : 'btn-primary' %>">
                    <%= prod.isAvailable ? 'Báo Hết' : 'Bật Bán' %>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="8" class="text-center empty-state">
              Chưa có sản phẩm nào. Hãy chạy script nạp thực đơn: <code>npm run seed</code> hoặc <code>npm run seed:all</code>!
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
