<%- include('partials/header') %>

<div class="workspace-hero">
  <div class="hero-text-block">
    <div class="hero-tag">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
      <span>DANH MỤC THỰC ĐƠN & ĐỊNH GIÁ TOÀN HỆ THỐNG</span>
    </div>
    <h1 class="hero-heading">Quản Lý Thực Đơn & Món Ăn</h1>
    <p class="hero-subheading">Danh mục thức uống đặc sản Đà Nẵng, bánh thủ công và giá theo size (Slot 7 & Slot 12)</p>
  </div>
  
  <div class="hero-actions">
    <a href="/api/uploads/template/product-import" class="btn btn-tonal">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
      <span>Tải Mẫu CSV Thực Đơn</span>
    </a>
  </div>
</div>

<!-- Multer Image Upload Workshop (Slot 12 Demo) -->
<div class="content-surface upload-workshop-surface">
  <div class="surface-header">
    <div class="surface-title-group">
      <div class="surface-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
      </div>
      <div>
        <h2 class="surface-title">Tải Lên Hình Ảnh Món Ăn (Multer Multipart Engine)</h2>
        <p class="surface-caption">Thử nghiệm upload tệp tin tĩnh theo chuẩn Slot 12 lưu trữ vào thư mục /uploads</p>
      </div>
    </div>
  </div>

  <div class="surface-body">
    <form action="/api/uploads/single" method="POST" enctype="multipart/form-data" target="_blank" class="artisan-upload-form">
      <div class="drop-zone-box">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="drop-svg"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
        <div class="drop-text-col">
          <strong>Chọn tệp hình ảnh từ thiết bị của bạn</strong>
          <span>Chấp nhận định dạng: JPEG, PNG, WEBP, GIF (Dung lượng tối đa 5MB)</span>
        </div>
        <label for="imageUpload" class="btn btn-tonal-sm custom-upload-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          <span id="fileNameLabel">Duyệt Ảnh Từ Thiết Bị...</span>
        </label>
        <input type="file" name="image" id="imageUpload" accept="image/*" required class="hidden-file-input" onchange="document.getElementById('fileNameLabel').textContent = (this.files && this.files[0]) ? this.files[0].name : 'Duyệt Ảnh Từ Thiết Bị...'">
      </div>
      <div class="upload-btn-row">
        <button type="submit" class="btn btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
          <span>Tải Lên Thư Mục /uploads</span>
        </button>
        <span class="upload-spec-hint">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
          Tệp sẽ tự động được phục vụ qua HTTP tĩnh: <code>/uploads/:filename</code>
        </span>
      </div>
    </form>
  </div>
</div>

<!-- Product Master Table -->
<div class="content-surface">
  <div class="surface-header">
    <div class="surface-title-group">
      <div class="surface-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
      </div>
      <div>
        <h2 class="surface-title">Thực Đơn Đang Kinh Doanh (<%= products ? products.length : 0 %> món)</h2>
        <p class="surface-caption">Danh sách sản phẩm được đồng bộ trên ứng dụng di động và hệ thống POS</p>
      </div>
    </div>
  </div>

  <div class="table-container">
    <table class="data-table">
      <thead>
        <tr>
          <th style="width: 70px;">HÌNH ẢNH</th>
          <th style="min-width: 220px;">TÊN MÓN ĂN & MÔ TẢ</th>
          <th style="min-width: 150px;">DANH MỤC</th>
          <th style="min-width: 110px;" class="text-right">GIÁ CƠ BẢN</th>
          <th style="min-width: 170px;">ĐỊNH GIÁ THEO SIZE (S / M / L)</th>
          <th style="min-width: 100px; white-space: nowrap;">CALO</th>
          <th style="min-width: 110px;">TRẠNG THÁI</th>
          <th style="min-width: 110px;" class="text-center">THAO TÁC</th>
        </tr>
      </thead>
      <tbody>
        <% if (products && products.length > 0) { %>
          <% products.forEach(prod => { %>
            <tr class="table-row">
              <td>
                <img src="<%= prod.imageUrl || 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=200' %>" 
                     alt="<%= prod.name %>" class="artisan-product-thumb">
              </td>
              <td>
                <div class="product-title-group">
                  <span class="product-main-name"><%= prod.name %></span>
                  <% if (prod.isBestSeller) { %>
                    <span class="bestseller-tag">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                      <span>Signature</span>
                    </span>
                  <% } %>
                </div>
                <div class="product-sub-desc"><%= prod.description || '' %></div>
              </td>
              <td>
                <span class="category-capsule text-nowrap">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8h1a4 4 0 0 1 0 8h-1"></path><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path></svg>
                  <%= (prod.categoryId && prod.categoryId.name) || 'Khác' %>
                </span>
              </td>
              <td class="text-right font-mono font-bold amount-cell text-nowrap">
                <%= Number(prod.price || 0).toLocaleString('vi-VN') %>đ
              </td>
              <td>
                <% if (prod.sizePricing && (prod.sizePricing.S || prod.sizePricing.M || prod.sizePricing.L)) { %>
                  <div class="size-chips-cluster">
                    <% if (prod.sizePricing.S) { %>
                      <span class="size-chip"><span class="size-letter">S</span><%= Number(prod.sizePricing.S).toLocaleString('vi-VN') %>đ</span>
                    <% } %>
                    <% if (prod.sizePricing.M) { %>
                      <span class="size-chip"><span class="size-letter">M</span><%= Number(prod.sizePricing.M).toLocaleString('vi-VN') %>đ</span>
                    <% } %>
                    <% if (prod.sizePricing.L) { %>
                      <span class="size-chip"><span class="size-letter">L</span><%= Number(prod.sizePricing.L).toLocaleString('vi-VN') %>đ</span>
                    <% } %>
                  </div>
                <% } else { %>
                  <span class="text-muted text-xs">Cỡ tiêu chuẩn</span>
                <% } %>
              </td>
              <td>
                <span class="calorie-tag font-mono text-nowrap">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 3.5z"></path></svg>
                  <span><%= prod.calories || 0 %> kcal</span>
                </span>
              </td>
              <td>
                <% if (prod.isAvailable) { %>
                  <span class="stock-badge stock-in text-nowrap">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    <span>Đang Bán</span>
                  </span>
                <% } else { %>
                  <span class="stock-badge stock-out text-nowrap">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line></svg>
                    <span>Tạm Hết</span>
                  </span>
                <% } %>
              </td>
              <td class="text-center">
                <form action="/admin/products/<%= prod._id %>/toggle" method="POST" class="inline-block">
                  <button type="submit" class="btn-toggle-stock <%= prod.isAvailable ? 'btn-stock-out' : 'btn-stock-in' %> text-nowrap" 
                          title="<%= prod.isAvailable ? 'Chuyển sang trạng thái tạm hết hàng' : 'Bật bán trở lại' %>">
                    <% if (prod.isAvailable) { %>
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                      <span>Báo Hết</span>
                    <% } else { %>
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                      <span>Bật Bán</span>
                    <% } %>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="8" class="empty-cell">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="empty-svg"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path></svg>
              <p>Chưa có sản phẩm nào. Hãy chạy lệnh <code>npm run seed:all</code> để nạp thực đơn Đà Nẵng!</p>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
