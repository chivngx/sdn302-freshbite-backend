<%- include('partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">☕ Màn Hình Quầy Barista (KDS)</h1>
    <p class="page-subtitle">Kitchen Display System thời gian thực phục vụ tiếp nhận & pha chế đơn hàng</p>
  </div>
  <div class="header-actions">
    <button onclick="window.location.reload()" class="btn btn-secondary">🔄 Làm Mới</button>
  </div>
</div>

<!-- Bộ lọc Chi Nhánh & Trạng Thái -->
<div class="filter-card">
  <form method="GET" action="/admin/orders" class="filter-form">
    <div class="filter-group">
      <label for="branchSelect">📍 Chi Nhánh:</label>
      <select name="branchId" id="branchSelect" onchange="this.form.submit()" class="form-select">
        <option value="">-- Tất cả 4 chi nhánh Đà Nẵng --</option>
        <% branches.forEach(branch => { %>
          <option value="<%= branch._id %>" <%= String(currentBranchId) === String(branch._id) ? 'selected' : '' %>>
            [<%= branch.district %>] <%= branch.name %>
          </option>
        <% }) %>
      </select>
    </div>

    <div class="filter-group">
      <label for="statusSelect">🏷️ Trạng Thái:</label>
      <select name="status" id="statusSelect" onchange="this.form.submit()" class="form-select">
        <option value="">-- Tất cả trạng thái --</option>
        <option value="Pending" <%= currentStatus === 'Pending' ? 'selected' : '' %>>⏳ Chờ xác nhận (Pending)</option>
        <option value="Preparing" <%= currentStatus === 'Preparing' ? 'selected' : '' %>>☕ Đang pha chế (Preparing)</option>
        <option value="Ready for Pickup" <%= currentStatus === 'Ready for Pickup' ? 'selected' : '' %>>🔔 Sẵn sàng nhận (Ready)</option>
        <option value="Completed" <%= currentStatus === 'Completed' ? 'selected' : '' %>>✅ Đã hoàn tất (Completed)</option>
        <option value="Cancelled" <%= currentStatus === 'Cancelled' ? 'selected' : '' %>>❌ Đã hủy (Cancelled)</option>
      </select>
    </div>
  </form>
</div>

<!-- Lưới đơn hàng KDS Barista -->
<div class="kds-grid">
  <% if (orders && orders.length > 0) { %>
    <% orders.forEach(order => { %>
      <div class="kds-card <%= order.status.toLowerCase().replace(/\s+/g, '-') %>">
        <div class="kds-card-header">
          <div>
            <span class="kds-order-code"><%= order.orderCode || order._id %></span>
            <span class="kds-time">
              ⏱️ <%= new Date(order.createdAt).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) %>
            </span>
          </div>
          <% 
            let badgeClass = 'badge-pending';
            if (order.status === 'Preparing') badgeClass = 'badge-preparing';
            else if (order.status === 'Ready for Pickup') badgeClass = 'badge-ready';
            else if (order.status === 'Completed') badgeClass = 'badge-completed';
            else if (order.status === 'Cancelled') badgeClass = 'badge-cancelled';
          %>
          <span class="badge <%= badgeClass %>"><%= order.status %></span>
        </div>

        <div class="kds-customer">
          <strong>👤 <%= (order.userId && order.userId.fullName) || 'Khách vãng lai' %></strong>
          <span>📞 <%= (order.userId && order.userId.phone) || 'Không có SĐT' %></span>
          <span class="kds-branch-badge">📍 <%= (order.branchId && order.branchId.name) || 'Chi nhánh Đà Nẵng' %></span>
        </div>

        <div class="kds-items-list">
          <% (order.items || []).forEach(item => { %>
            <div class="kds-item-row">
              <span class="kds-item-qty"><%= item.quantity %>x</span>
              <div class="kds-item-detail">
                <span class="kds-item-name"><%= (item.productId && item.productId.name) || item.name || 'Sản phẩm' %></span>
                <span class="kds-item-size">Size: <strong><%= item.size || 'M' %></strong></span>
              </div>
              <span class="kds-item-price"><%= Number(item.price * item.quantity).toLocaleString('vi-VN') %>đ</span>
            </div>
          <% }) %>
        </div>

        <div class="kds-card-footer">
          <div class="kds-total-row">
            <span>Tổng: <strong><%= Number(order.totalAmount || 0).toLocaleString('vi-VN') %>đ</strong></span>
            <span class="kds-pay-badge"><%= order.paymentMethod %> (<%= order.paymentStatus || 'PENDING' %>)</span>
          </div>

          <!-- Nút bấm chuyển trạng thái cho quầy Barista -->
          <div class="kds-action-buttons">
            <% if (order.status === 'Pending') { %>
              <form method="POST" action="/admin/orders/<%= order._id %>/status" class="inline-form">
                <input type="hidden" name="status" value="Preparing">
                <button type="submit" class="btn-kds btn-preparing">☕ Pha Chế</button>
              </form>
              <form method="POST" action="/admin/orders/<%= order._id %>/status" class="inline-form">
                <input type="hidden" name="status" value="Cancelled">
                <button type="submit" class="btn-kds btn-cancel" onclick="return confirm('Bạn có chắc muốn hủy đơn này?')">❌ Hủy</button>
              </form>
            <% } else if (order.status === 'Preparing') { %>
              <form method="POST" action="/admin/orders/<%= order._id %>/status" class="inline-form">
                <input type="hidden" name="status" value="Ready for Pickup">
                <button type="submit" class="btn-kds btn-ready">🔔 Sẵn Sàng</button>
              </form>
            <% } else if (order.status === 'Ready for Pickup') { %>
              <form method="POST" action="/admin/orders/<%= order._id %>/status" class="inline-form">
                <input type="hidden" name="status" value="Completed">
                <button type="submit" class="btn-kds btn-complete">✅ Giao Xong</button>
              </form>
            <% } %>

            <a href="/api/uploads/orders/<%= order._id %>/invoice" class="btn-kds btn-invoice" title="Tải Hóa Đơn Bán Lẻ (res.download - Slot 12)">
              📄 Hóa Đơn
            </a>
          </div>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <div class="empty-kds">
      <h3>☕ Hiện tại chưa có đơn hàng nào cần xử lý!</h3>
      <p>Khi khách hàng đặt món qua ứng dụng di động hoặc web, đơn hàng sẽ lập tức xuất hiện tại đây.</p>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
