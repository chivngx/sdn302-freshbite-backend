<%- include('partials/header') %>

<!-- Island Header -->
<div class="island-header-bar">
  <div class="island-title-block">
    <div class="island-category-badge">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="2" y="6" width="20" height="12" rx="2"></rect><path d="M6 2v4"></path><path d="M18 2v4"></path></svg>
      <span>KITCHEN DISPLAY SYSTEM (BARISTA STATION)</span>
    </div>
    <h1 class="island-heading">Màn Hình Quầy Barista (KDS)</h1>
    <p class="island-description">Hệ thống điều phối vé pha chế thời gian thực tại các quầy bar FreshBite. Tối ưu thời gian phục vụ thức uống nóng/lạnh.</p>
  </div>
  
  <div class="island-actions-group">
    <button onclick="window.location.reload()" class="m3-btn m3-btn-tonal">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
      <span>Làm Mới Trạm KDS</span>
    </button>
  </div>
</div>

<!-- KDS Filter & Action Strip -->
<div class="kds-action-strip">
  <form method="GET" action="/admin/orders" style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap; width: 100%;">
    <div style="display: flex; align-items: center; gap: 8px;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--md-sys-color-secondary);"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
      <select name="branchId" onchange="this.form.submit()" class="kds-branch-dropdown">
        <option value="">-- Tất cả 4 chi nhánh Đà Nẵng --</option>
        <% branches.forEach(branch => { %>
          <option value="<%= branch._id %>" <%= String(currentBranchId) === String(branch._id) ? 'selected' : '' %>>
            [<%= branch.district %>] <%= branch.name %>
          </option>
        <% }) %>
      </select>
    </div>

    <div style="display: flex; align-items: center; gap: 8px; margin-left: auto;">
      <span style="font-size: 0.78rem; font-weight: 700; color: var(--md-sys-color-on-surface-variant); text-transform: uppercase;">Trạng thái vé:</span>
      <select name="status" onchange="this.form.submit()" class="kds-branch-dropdown">
        <option value="">-- Tất cả trạng thái --</option>
        <option value="Pending" <%= currentStatus === 'Pending' ? 'selected' : '' %>>Chờ xác nhận (Pending)</option>
        <option value="Preparing" <%= currentStatus === 'Preparing' ? 'selected' : '' %>>Đang pha chế (Preparing)</option>
        <option value="Ready for Pickup" <%= currentStatus === 'Ready for Pickup' ? 'selected' : '' %>>Sẵn sàng nhận (Ready)</option>
        <option value="Completed" <%= currentStatus === 'Completed' ? 'selected' : '' %>>Đã hoàn tất (Completed)</option>
        <option value="Cancelled" <%= currentStatus === 'Cancelled' ? 'selected' : '' %>>Đã hủy (Cancelled)</option>
      </select>
    </div>
  </form>
</div>

<!-- KDS Tickets Station Grid -->
<div class="kds-grid">
  <% if (orders && orders.length > 0) { %>
    <% orders.forEach(order => { %>
      <% 
        let ticketClass = 'ticket-pending';
        let badgeClass = 'badge-pending';
        if (order.status === 'Preparing') { ticketClass = 'ticket-preparing'; badgeClass = 'badge-preparing'; }
        else if (order.status === 'Ready for Pickup') { ticketClass = 'ticket-ready'; badgeClass = 'badge-ready'; }
        else if (order.status === 'Completed') { ticketClass = 'ticket-completed'; badgeClass = 'badge-completed'; }
        else if (order.status === 'Cancelled') { ticketClass = 'ticket-cancelled'; badgeClass = 'badge-cancelled'; }
      %>
      <div class="kds-ticket <%= ticketClass %>">
        <!-- Ticket Header Row -->
        <div class="ticket-header-row">
          <span class="ticket-order-tag"><%= order.orderCode || order._id %></span>
          <div style="display: flex; align-items: center; gap: 8px;">
            <div class="ticket-timer-pill">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              <span><%= new Date(order.createdAt).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) %></span>
            </div>
            <span class="m3-badge <%= badgeClass %>"><%= order.status %></span>
          </div>
        </div>

        <!-- Ticket Customer & Branch Strip -->
        <div class="ticket-customer-strip">
          <div class="ticket-guest-name">
            <%= (order.userId && order.userId.fullName) || 'Khách vãng lai' %>
          </div>
          <div class="ticket-branch-tag">
            <%= (order.branchId && order.branchId.name) || 'Trạm Trung Tâm' %>
          </div>
        </div>

        <!-- Ticket Coffee Items List -->
        <div class="ticket-items-list">
          <% if (order.items && order.items.length > 0) { %>
            <% order.items.forEach(item => { %>
              <div class="ticket-item-row">
                <span class="item-qty-pill"><%= item.quantity %>x</span>
                <div class="item-content">
                  <span class="item-name-text">
                    <%= (item.productId && item.productId.name) || item.name || 'Thức uống đặc sản' %>
                  </span>
                  <div class="item-spec-tags">
                    <% if (item.size) { %>
                      <span class="size-pill-tag">Size <%= item.size %></span>
                    <% } %>
                    <span><%= (item.price || 0).toLocaleString('vi-VN') %>đ</span>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div style="font-size: 0.8rem; color: var(--md-sys-color-on-surface-variant); font-style: italic;">
              Không có chi tiết món
            </div>
          <% } %>
        </div>

        <!-- Ticket Footer & Tactile Actions -->
        <div class="ticket-footer-actions">
          <% if (order.status === 'Pending') { %>
            <form action="/admin/orders/<%= order._id %>/status" method="POST">
              <input type="hidden" name="status" value="Preparing">
              <button type="submit" class="kds-btn-step kds-btn-start">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polygon points="10 8 16 12 10 16 10 8"></polygon></svg>
                <span>Bắt Đầu Pha Chế</span>
              </button>
            </form>
          <% } else if (order.status === 'Preparing') { %>
            <form action="/admin/orders/<%= order._id %>/status" method="POST">
              <input type="hidden" name="status" value="Ready for Pickup">
              <button type="submit" class="kds-btn-step kds-btn-finish">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Báo Đã Pha Xong (Sẵn Sàng)</span>
              </button>
            </form>
          <% } else if (order.status === 'Ready for Pickup') { %>
            <form action="/admin/orders/<%= order._id %>/status" method="POST">
              <input type="hidden" name="status" value="Completed">
              <button type="submit" class="kds-btn-step kds-btn-deliver">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                <span>Khách Đã Nhận Đơn</span>
              </button>
            </form>
          <% } else { %>
            <div style="text-align: center; font-size: 0.78rem; font-weight: 700; color: var(--md-sys-color-on-surface-variant); padding: 8px 0;">
              Vé Đã Hoàn Tất Xử Lý
            </div>
          <% } %>

          <div class="kds-sub-actions">
            <span style="font-family: var(--font-mono); font-weight: 800; font-size: 0.88rem; color: var(--md-sys-color-primary);">
              <%= (order.totalAmount || 0).toLocaleString('vi-VN') %>đ
            </span>
            <a href="/api/uploads/orders/<%= order._id %>/invoice" class="kds-link-invoice" title="In Hóa Đơn Bán Lẻ (Slot 12)">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
              <span>In Hóa Đơn</span>
            </a>
          </div>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <div style="grid-column: 1 / -1; text-align: center; padding: 60px 20px; background-color: var(--md-sys-color-surface-container); border-radius: var(--md-shape-xl);">
      <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--md-sys-color-secondary); margin-bottom: 12px;"><rect x="2" y="6" width="20" height="12" rx="2"></rect><path d="M6 2v4"></path><path d="M18 2v4"></path></svg>
      <h3 style="font-weight: 800; color: var(--md-sys-color-primary); margin-bottom: 6px;">Không có vé pha chế nào cần xử lý</h3>
      <p style="font-size: 0.85rem; color: var(--md-sys-color-on-surface-variant);">Toàn bộ đơn hàng tại các chi nhánh đã hoàn tất hoặc đang chờ khách đặt mới.</p>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
