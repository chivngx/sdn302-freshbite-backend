<%- include('partials/header') %>

<div class="workspace-hero">
  <div class="hero-text-block">
    <div class="hero-tag">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
      <span>HỆ THỐNG GIÁM SÁT KINH DOANH CHUỖI CỬA HÀNG</span>
    </div>
    <h1 class="hero-heading">Bảng Quản Trị & Doanh Thu Quầy</h1>
    <p class="hero-subheading">Hệ thống giám sát kinh doanh & vận hành 4 chi nhánh FreshBite Đà Nẵng trong thời gian thực</p>
  </div>
  
  <div class="hero-actions">
    <a href="/api/uploads/template/product-import" class="btn btn-tonal">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
      <span>Tải Mẫu CSV Thực Đơn</span>
    </a>
    <a href="/admin/orders" class="btn btn-primary">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"></rect><path d="M6 2v4"></path><path d="M18 2v4"></path></svg>
      <span>Mở Màn Hình KDS Barista</span>
    </a>
  </div>
</div>

<!-- KPI Cards Bento Grid -->
<div class="kpi-bento-grid">
  <div class="kpi-card kpi-revenue">
    <div class="kpi-top">
      <div class="kpi-icon-bubble">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
      </div>
      <span class="kpi-badge kpi-badge-revenue">DOANH THU ĐÃ THU</span>
    </div>
    <div class="kpi-amount">
      <%= (stats.totalRevenue || 0).toLocaleString('vi-VN') %> <span class="kpi-unit">VNĐ</span>
    </div>
    <div class="kpi-footer-note">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
      <span>Tổng kết từ các đơn hàng trạng thái Completed</span>
    </div>
  </div>

  <div class="kpi-card kpi-tickets">
    <div class="kpi-top">
      <div class="kpi-icon-bubble">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
      </div>
      <span class="kpi-badge kpi-badge-tickets">TỔNG LƯỢNG VÉ</span>
    </div>
    <div class="kpi-amount">
      <%= stats.totalOrders || 0 %> <span class="kpi-unit">đơn hàng</span>
    </div>
    <div class="kpi-footer-note">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
      <span>Ghi nhận trên toàn hệ thống 4 chi nhánh</span>
    </div>
  </div>

  <div class="kpi-card kpi-queue">
    <div class="kpi-top">
      <div class="kpi-icon-bubble">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      </div>
      <span class="kpi-badge kpi-badge-queue">HÀNG ĐỢI PHA CHẾ</span>
    </div>
    <div class="kpi-amount">
      <%= (stats.statusCounts.Pending || 0) + (stats.statusCounts.Preparing || 0) %> <span class="kpi-unit">đơn</span>
    </div>
    <div class="kpi-footer-note">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8h1a4 4 0 0 1 0 8h-1"></path><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path></svg>
      <span><%= stats.statusCounts.Pending || 0 %> chờ nhận • <%= stats.statusCounts.Preparing || 0 %> đang trên máy pha</span>
    </div>
  </div>

  <div class="kpi-card kpi-completed">
    <div class="kpi-top">
      <div class="kpi-icon-bubble">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
      </div>
      <span class="kpi-badge kpi-badge-completed">ĐÃ GIAO KHÁCH</span>
    </div>
    <div class="kpi-amount">
      <%= stats.statusCounts.Completed || 0 %> <span class="kpi-unit">đơn</span>
    </div>
    <div class="kpi-footer-note">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
      <span><%= stats.statusCounts['Ready for Pickup'] || 0 %> đơn đang đợi khách lấy tại quầy</span>
    </div>
  </div>
</div>

<!-- Operational Status Strip -->
<div class="status-strip">
  <div class="strip-item strip-pending">
    <span class="strip-dot"></span>
    <span class="strip-label">Chờ xác nhận:</span>
    <span class="strip-val"><%= stats.statusCounts.Pending || 0 %></span>
  </div>
  <div class="strip-item strip-preparing">
    <span class="strip-dot"></span>
    <span class="strip-label">Đang pha chế:</span>
    <span class="strip-val"><%= stats.statusCounts.Preparing || 0 %></span>
  </div>
  <div class="strip-item strip-ready">
    <span class="strip-dot"></span>
    <span class="strip-label">Sẵn sàng nhận:</span>
    <span class="strip-val"><%= stats.statusCounts['Ready for Pickup'] || 0 %></span>
  </div>
  <div class="strip-item strip-completed">
    <span class="strip-dot"></span>
    <span class="strip-label">Hoàn tất:</span>
    <span class="strip-val"><%= stats.statusCounts.Completed || 0 %></span>
  </div>
  <div class="strip-item strip-cancelled">
    <span class="strip-dot"></span>
    <span class="strip-label">Đã hủy:</span>
    <span class="strip-val"><%= stats.statusCounts.Cancelled || 0 %></span>
  </div>
</div>

<!-- Recent Orders Data Surface -->
<div class="content-surface">
  <div class="surface-header">
    <div class="surface-title-group">
      <div class="surface-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      </div>
      <div>
        <h2 class="surface-title">Đơn Hàng Gần Đây</h2>
        <p class="surface-caption">Danh sách 8 đơn mới nhất được đẩy về máy chủ trung tâm</p>
      </div>
    </div>
    <a href="/admin/orders" class="btn btn-tonal-sm">
      <span>Màn hình KDS chi tiết</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
    </a>
  </div>

  <div class="table-container">
    <table class="data-table">
      <thead>
        <tr>
          <th style="min-width: 120px;">MÃ VÉ ĐƠN</th>
          <th style="min-width: 170px;">KHÁCH HÀNG</th>
          <th style="min-width: 200px;">CHI NHÁNH</th>
          <th style="min-width: 130px; white-space: nowrap;">THỜI GIAN</th>
          <th style="min-width: 140px;">PHƯƠNG THỨC TT</th>
          <th style="min-width: 110px;" class="text-right">TỔNG TIỀN</th>
          <th style="min-width: 140px;">TRẠNG THÁI</th>
          <th style="min-width: 100px;" class="text-center">THAO TÁC</th>
        </tr>
      </thead>
      <tbody>
        <% if (recentOrders && recentOrders.length > 0) { %>
          <% recentOrders.forEach(order => { %>
            <tr class="table-row">
              <td>
                <span class="order-code-badge"><%= order.orderCode || order._id %></span>
              </td>
              <td>
                <div class="customer-cell">
                  <span class="customer-name"><%= (order.userId && order.userId.fullName) || 'Khách vãng lai' %></span>
                  <span class="customer-phone"><%= (order.userId && order.userId.phone) || '' %></span>
                </div>
              </td>
              <td>
                <span class="branch-pill">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
                  <%= (order.branchId && order.branchId.name) || 'Đà Nẵng' %>
                </span>
              </td>
              <td class="font-mono text-nowrap">
                <%= new Date(order.createdAt).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) %> <span class="text-muted"><%= new Date(order.createdAt).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit' }) %></span>
              </td>
              <td>
                <span class="payment-chip chip-<%= String(order.paymentMethod).toLowerCase() %>">
                  <%= order.paymentMethod %>
                </span>
              </td>
              <td class="text-right font-mono font-bold amount-cell text-nowrap">
                <%= (order.totalAmount || 0).toLocaleString('vi-VN') %>đ
              </td>
              <td>
                <% 
                  let badgeModifier = 'badge-pending';
                  if (order.status === 'Preparing') { badgeModifier = 'badge-preparing'; }
                  else if (order.status === 'Ready for Pickup') { badgeModifier = 'badge-ready'; }
                  else if (order.status === 'Completed') { badgeModifier = 'badge-completed'; }
                  else if (order.status === 'Cancelled') { badgeModifier = 'badge-cancelled'; }
                %>
                <span class="status-badge <%= badgeModifier %> text-nowrap">
                  <span><%= order.status %></span>
                </span>
              </td>
              <td>
                <div class="action-flex-center">
                  <a href="/api/uploads/orders/<%= order._id %>/invoice" class="btn-icon-action" title="Tải Hóa Đơn Bán Lẻ (Slot 12 res.download)">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                  </a>
                  <a href="/admin/orders?status=<%= order.status %>" class="btn-icon-action btn-icon-highlight" title="Xử lý trên KDS">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                  </a>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="8" class="empty-cell">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="empty-svg"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
              <p>Chưa có đơn hàng nào trong hệ thống. Hãy chạy lệnh <code>npm run seed:all</code> để tạo dữ liệu mẫu!</p>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
