<%- include('partials/header') %>

<!-- Island Header -->
<div class="island-header-bar">
  <div class="island-title-block">
    <div class="island-category-badge">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
      <span>TỔNG QUAN CHUỖI ĐÀ NẴNG</span>
    </div>
    <h1 class="island-heading">Bảng Quản Trị & Doanh Thu Quầy</h1>
    <p class="island-description">Hệ thống giám sát kinh doanh & vận hành 4 chi nhánh FreshBite Đà Nẵng trong thời gian thực.</p>
  </div>
  
  <div class="island-actions-group">
    <a href="/api/uploads/template/product-import" class="m3-btn m3-btn-tonal">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
      <span>Tải Mẫu CSV</span>
    </a>
    <a href="/admin/orders" class="m3-btn m3-btn-filled">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"></rect><path d="M6 2v4"></path><path d="M18 2v4"></path></svg>
      <span>Mở Trạm KDS</span>
    </a>
  </div>
</div>

<!-- Bento Metrics Grid -->
<div class="m3-bento-grid">
  <!-- Metric 1: Revenue -->
  <div class="m3-bento-card bento-accent-espresso">
    <div class="bento-card-top">
      <div class="bento-icon-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
      </div>
      <span class="bento-label">DOANH THU</span>
    </div>
    <div class="bento-value-block">
      <div class="bento-number"><%= (stats.totalRevenue || 0).toLocaleString('vi-VN') %><span class="bento-unit">đ</span></div>
    </div>
    <div class="bento-footnote">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
      <span>Đơn hàng Completed</span>
    </div>
  </div>

  <!-- Metric 2: Orders Count -->
  <div class="m3-bento-card">
    <div class="bento-card-top">
      <div class="bento-icon-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
      </div>
      <span class="bento-label">TỔNG LƯỢNG VÉ</span>
    </div>
    <div class="bento-value-block">
      <div class="bento-number"><%= stats.totalOrders || 0 %><span class="bento-unit">vé</span></div>
    </div>
    <div class="bento-footnote">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      <span>Toàn chuỗi 4 chi nhánh</span>
    </div>
  </div>

  <!-- Metric 3: Queue -->
  <div class="m3-bento-card">
    <div class="bento-card-top">
      <div class="bento-icon-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      </div>
      <span class="bento-label">ĐỢI PHA CHẾ</span>
    </div>
    <div class="bento-value-block">
      <div class="bento-number"><%= (stats.statusCounts.Pending || 0) + (stats.statusCounts.Preparing || 0) %><span class="bento-unit">vé</span></div>
    </div>
    <div class="bento-footnote">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8h1a4 4 0 0 1 0 8h-1"></path><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path></svg>
      <span><%= stats.statusCounts.Pending || 0 %> chờ • <%= stats.statusCounts.Preparing || 0 %> đang pha</span>
    </div>
  </div>

  <!-- Metric 4: Completed -->
  <div class="m3-bento-card">
    <div class="bento-card-top">
      <div class="bento-icon-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
      </div>
      <span class="bento-label">ĐÃ GIAO KHÁCH</span>
    </div>
    <div class="bento-value-block">
      <div class="bento-number"><%= stats.statusCounts.Completed || 0 %><span class="bento-unit">đơn</span></div>
    </div>
    <div class="bento-footnote">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
      <span><%= stats.statusCounts['Ready for Pickup'] || 0 %> sẵn sàng nhận</span>
    </div>
  </div>
</div>

<!-- Operational Flow Strip -->
<div class="m3-status-flow-bar">
  <div class="flow-step-chip chip-pending">
    <span>Chờ xác nhận</span>
    <span class="flow-step-count"><%= stats.statusCounts.Pending || 0 %></span>
  </div>
  <div class="flow-step-chip chip-prep">
    <span>Đang pha chế</span>
    <span class="flow-step-count"><%= stats.statusCounts.Preparing || 0 %></span>
  </div>
  <div class="flow-step-chip chip-ready">
    <span>Sẵn sàng nhận</span>
    <span class="flow-step-count"><%= stats.statusCounts['Ready for Pickup'] || 0 %></span>
  </div>
  <div class="flow-step-chip chip-completed">
    <span>Đã hoàn tất</span>
    <span class="flow-step-count"><%= stats.statusCounts.Completed || 0 %></span>
  </div>
  <div class="flow-step-chip">
    <span>Đã hủy</span>
    <span class="flow-step-count"><%= stats.statusCounts.Cancelled || 0 %></span>
  </div>
</div>

<!-- Borderless Data Table Card -->
<div class="m3-table-card">
  <div class="table-top-bar">
    <div>
      <h2 class="table-top-title">Đơn Hàng Gần Đây</h2>
      <p class="table-top-caption">Đồng bộ từ hệ thống POS và ứng dụng FreshBite</p>
    </div>
    <a href="/admin/orders" class="m3-btn m3-btn-outlined" style="height: 32px; padding: 0 12px; font-size: 0.78rem;">
      <span>Mở KDS</span>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </a>
  </div>

  <div class="m3-table-wrapper">
    <table class="m3-table">
      <thead>
        <tr>
          <th>MÃ ĐƠN</th>
          <th>KHÁCH HÀNG</th>
          <th>CHI NHÁNH</th>
          <th>GIỜ ĐẶT</th>
          <th>THANH TOÁN</th>
          <th style="text-align: right;">TỔNG TIỀN</th>
          <th>TRẠNG THÁI</th>
          <th style="text-align: center;">HÓA ĐƠN</th>
        </tr>
      </thead>
      <tbody>
        <% if (recentOrders && recentOrders.length > 0) { %>
          <% recentOrders.forEach(order => { %>
            <tr>
              <td>
                <span class="order-code-tag"><%= order.orderCode || order._id %></span>
              </td>
              <td>
                <div class="customer-name-cell"><%= (order.userId && order.userId.fullName) || 'Khách vãng lai' %></div>
                <div class="customer-sub-cell"><%= (order.userId && order.userId.phone) || 'Tại quầy' %></div>
              </td>
              <td>
                <span style="font-weight: 600; font-size: 0.8rem; color: var(--md-sys-color-primary); white-space: nowrap;">
                  <%= (order.branchId && order.branchId.name) || 'Đà Nẵng Central' %>
                </span>
              </td>
              <td style="font-family: var(--font-mono); font-size: 0.8rem; white-space: nowrap;">
                <%= new Date(order.createdAt).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) %>
              </td>
              <td>
                <% 
                  let payText = order.paymentMethod;
                  if (payText === 'CASH_AT_COUNTER') payText = 'Tiền mặt';
                  else if (payText === 'MOMO') payText = 'Ví MoMo';
                  else if (payText === 'VNPAY') payText = 'VNPay QR';
                %>
                <span style="font-size: 0.75rem; font-weight: 700; color: var(--md-sys-color-secondary); white-space: nowrap;">
                  <%= payText %>
                </span>
              </td>
              <td style="text-align: right; font-family: var(--font-mono); font-weight: 800; font-size: 0.88rem; color: var(--md-sys-color-primary); white-space: nowrap;">
                <%= (order.totalAmount || 0).toLocaleString('vi-VN') %>đ
              </td>
              <td>
                <% 
                  let badgeClass = 'badge-pending';
                  if (order.status === 'Preparing') { badgeClass = 'badge-preparing'; }
                  else if (order.status === 'Ready for Pickup') { badgeClass = 'badge-ready'; }
                  else if (order.status === 'Completed') { badgeClass = 'badge-completed'; }
                  else if (order.status === 'Cancelled') { badgeClass = 'badge-cancelled'; }
                %>
                <span class="m3-badge <%= badgeClass %>">
                  <%= order.status %>
                </span>
              </td>
              <td style="text-align: center;">
                <div style="display: inline-flex; align-items: center; gap: 4px;">
                  <a href="/api/uploads/orders/<%= order._id %>/invoice" class="m3-btn-icon" title="Tải Hóa Đơn (Slot 12)">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                  </a>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="8" style="text-align: center; padding: 32px; color: var(--md-sys-color-on-surface-variant);">
              Chưa có dữ liệu đơn hàng
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
