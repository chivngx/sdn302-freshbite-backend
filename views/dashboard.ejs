<%- include('partials/header') %>

<div class="workspace-hero">
  <div class="hero-text-block">
    <div class="hero-tag">
      <span class="material-symbols-outlined icon-inline">analytics</span>
      <span>HỆ THỐNG GIÁM SÁT KINH DOANH CHUỖI CỬA HÀNG</span>
    </div>
    <h1 class="hero-heading">Bảng Quản Trị & Doanh Thu Quầy</h1>
    <p class="hero-subheading">Hệ thống giám sát kinh doanh & vận hành 4 chi nhánh FreshBite Đà Nẵng trong thời gian thực</p>
  </div>
  
  <div class="hero-actions">
    <a href="/api/uploads/template/product-import" class="btn btn-tonal">
      <span class="material-symbols-outlined">download</span>
      <span>Tải Mẫu CSV Thực Đơn</span>
    </a>
    <a href="/admin/orders" class="btn btn-primary">
      <span class="material-symbols-outlined">coffee_maker</span>
      <span>Mở Màn Hình KDS Barista</span>
    </a>
  </div>
</div>

<!-- KPI Cards Bento Grid -->
<div class="kpi-bento-grid">
  <div class="kpi-card kpi-revenue">
    <div class="kpi-top">
      <div class="kpi-icon-bubble">
        <span class="material-symbols-outlined">payments</span>
      </div>
      <span class="kpi-badge-positive">DOANH THU ĐÃ THU</span>
    </div>
    <div class="kpi-amount">
      <%= (stats.totalRevenue || 0).toLocaleString('vi-VN') %> <span class="kpi-unit">VNĐ</span>
    </div>
    <div class="kpi-footer-note">
      <span class="material-symbols-outlined icon-micro">check_circle</span>
      Tổng kết từ các đơn hàng trạng thái Completed
    </div>
  </div>

  <div class="kpi-card kpi-tickets">
    <div class="kpi-top">
      <div class="kpi-icon-bubble">
        <span class="material-symbols-outlined">receipt_long</span>
      </div>
      <span class="kpi-badge-neutral">TỔNG LƯỢNG VÉ</span>
    </div>
    <div class="kpi-amount">
      <%= stats.totalOrders || 0 %> <span class="kpi-unit">đơn hàng</span>
    </div>
    <div class="kpi-footer-note">
      <span class="material-symbols-outlined icon-micro">dataset</span>
      Ghi nhận trên toàn hệ thống 4 chi nhánh
    </div>
  </div>

  <div class="kpi-card kpi-queue">
    <div class="kpi-top">
      <div class="kpi-icon-bubble">
        <span class="material-symbols-outlined">hourglass_top</span>
      </div>
      <span class="kpi-badge-urgent">HÀNG ĐỢI PHA CHẾ</span>
    </div>
    <div class="kpi-amount">
      <%= (stats.statusCounts.Pending || 0) + (stats.statusCounts.Preparing || 0) %> <span class="kpi-unit">đơn</span>
    </div>
    <div class="kpi-footer-note">
      <span class="material-symbols-outlined icon-micro">pending_actions</span>
      <%= stats.statusCounts.Pending || 0 %> chờ nhận • <%= stats.statusCounts.Preparing || 0 %> đang trên máy pha
    </div>
  </div>

  <div class="kpi-card kpi-completed">
    <div class="kpi-top">
      <div class="kpi-icon-bubble">
        <span class="material-symbols-outlined">task_alt</span>
      </div>
      <span class="kpi-badge-success">ĐÃ GIAO KHÁCH</span>
    </div>
    <div class="kpi-amount">
      <%= stats.statusCounts.Completed || 0 %> <span class="kpi-unit">đơn</span>
    </div>
    <div class="kpi-footer-note">
      <span class="material-symbols-outlined icon-micro">notifications_active</span>
      <%= stats.statusCounts['Ready for Pickup'] || 0 %> đơn đang đợi khách tại quầy
    </div>
  </div>
</div>

<!-- Operational Status Strip -->
<div class="status-strip">
  <div class="strip-item strip-pending">
    <span class="strip-dot"></span>
    <span class="strip-label">Chờ xác nhận:</span>
    <span class="strip-val"><%= stats.statusCounts.Pending || 0 %></span>
  </div>
  <div class="strip-item strip-preparing">
    <span class="strip-dot"></span>
    <span class="strip-label">Đang pha chế:</span>
    <span class="strip-val"><%= stats.statusCounts.Preparing || 0 %></span>
  </div>
  <div class="strip-item strip-ready">
    <span class="strip-dot"></span>
    <span class="strip-label">Sẵn sàng nhận:</span>
    <span class="strip-val"><%= stats.statusCounts['Ready for Pickup'] || 0 %></span>
  </div>
  <div class="strip-item strip-completed">
    <span class="strip-dot"></span>
    <span class="strip-label">Hoàn tất:</span>
    <span class="strip-val"><%= stats.statusCounts.Completed || 0 %></span>
  </div>
  <div class="strip-item strip-cancelled">
    <span class="strip-dot"></span>
    <span class="strip-label">Đã hủy:</span>
    <span class="strip-val"><%= stats.statusCounts.Cancelled || 0 %></span>
  </div>
</div>

<!-- Table Container -->
<div class="content-surface">
  <div class="surface-header">
    <div class="surface-title-group">
      <span class="material-symbols-outlined surface-icon">history</span>
      <div>
        <h2 class="surface-title">Đơn Hàng Gần Đây</h2>
        <p class="surface-caption">Danh sách 8 đơn mới nhất được đẩy về máy chủ trung tâm</p>
      </div>
    </div>
    <a href="/admin/orders" class="btn btn-tonal-sm">
      <span>Màn hình KDS chi tiết</span>
      <span class="material-symbols-outlined icon-inline">arrow_forward</span>
    </a>
  </div>

  <div class="table-container">
    <table class="data-table">
      <thead>
        <tr>
          <th>MÃ VÉ ĐƠN</th>
          <th>KHÁCH HÀNG</th>
          <th>CHI NHÁNH</th>
          <th>THỜI GIAN</th>
          <th>PHƯƠNG THỨC TT</th>
          <th class="text-right">TỔNG TIỀN</th>
          <th>TRẠNG THÁI</th>
          <th class="text-center">THAO TÁC</th>
        </tr>
      </thead>
      <tbody>
        <% if (recentOrders && recentOrders.length > 0) { %>
          <% recentOrders.forEach(order => { %>
            <tr class="table-row">
              <td>
                <span class="order-code-badge"><%= order.orderCode || order._id %></span>
              </td>
              <td>
                <div class="customer-cell">
                  <span class="customer-name"><%= (order.userId && order.userId.fullName) || 'Khách vãng lai' %></span>
                  <span class="customer-phone"><%= (order.userId && order.userId.phone) || 'Không có SĐT' %></span>
                </div>
              </td>
              <td>
                <span class="branch-pill">
                  <span class="material-symbols-outlined icon-micro">store</span>
                  <%= (order.branchId && order.branchId.name) || 'Đà Nẵng' %>
                </span>
              </td>
              <td class="text-muted font-mono">
                <%= new Date(order.createdAt).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' }) %>
              </td>
              <td>
                <span class="payment-chip chip-<%= String(order.paymentMethod).toLowerCase() %>">
                  <%= order.paymentMethod %>
                </span>
              </td>
              <td class="text-right font-mono font-bold amount-cell">
                <%= (order.totalAmount || 0).toLocaleString('vi-VN') %>đ
              </td>
              <td>
                <% 
                  let badgeModifier = 'badge-pending';
                  let iconName = 'hourglass_empty';
                  if (order.status === 'Preparing') { badgeModifier = 'badge-preparing'; iconName = 'coffee'; }
                  else if (order.status === 'Ready for Pickup') { badgeModifier = 'badge-ready'; iconName = 'notifications_active'; }
                  else if (order.status === 'Completed') { badgeModifier = 'badge-completed'; iconName = 'done_all'; }
                  else if (order.status === 'Cancelled') { badgeModifier = 'badge-cancelled'; iconName = 'close'; }
                %>
                <span class="status-badge <%= badgeModifier %>">
                  <span class="material-symbols-outlined icon-micro"><%= iconName %></span>
                  <span><%= order.status %></span>
                </span>
              </td>
              <td>
                <div class="action-flex-center">
                  <a href="/api/uploads/orders/<%= order._id %>/invoice" class="btn-icon-action" title="Tải Hóa Đơn Bán Lẻ (Slot 12 res.download)">
                    <span class="material-symbols-outlined">receipt_long</span>
                  </a>
                  <a href="/admin/orders?status=<%= order.status %>" class="btn-icon-action btn-icon-highlight" title="Xử lý trên KDS">
                    <span class="material-symbols-outlined">chevron_right</span>
                  </a>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="8" class="empty-cell">
              <span class="material-symbols-outlined empty-icon">inbox</span>
              <p>Chưa có đơn hàng nào trong hệ thống. Hãy chạy lệnh <code>npm run seed:all</code> để tạo dữ liệu mẫu!</p>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
