<%- include('partials/header') %>

<!-- Island Header -->
<div class="island-header-bar">
  <div class="island-title-block">
    <div class="island-category-badge">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
      <span>CHẤT LƯỢNG MÓN ĂN & DỊCH VỤ</span>
    </div>
    <h1 class="island-heading">Đánh Giá & Phản Hồi Khách Hàng</h1>
    <p class="island-description">Hệ thống ghi nhận trải nghiệm hương vị, độ hài lòng và kiểm duyệt nhận xét tại 4 chi nhánh Đà Nẵng.</p>
  </div>

  <div class="island-actions-group">
    <button onclick="window.location.reload()" class="m3-btn m3-btn-tonal">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
      <span>Làm Mới</span>
    </button>
  </div>
</div>

<!-- Bento Metrics & Ratings Distribution -->
<div class="m3-bento-grid" style="grid-template-columns: 280px 1fr; margin-bottom: 24px;">
  <!-- Average Score Card -->
  <div class="m3-bento-card bento-accent-espresso" style="display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 28px 20px;">
    <span class="bento-label" style="margin-bottom: 6px;">ĐIỂM TRUNG BÌNH HỆ THỐNG</span>
    <div style="font-family: var(--font-mono); font-size: 3.2rem; font-weight: 800; line-height: 1; color: var(--md-sys-color-primary);">
      <%= stats.avgRating || '5.0' %>
    </div>
    <div style="display: flex; gap: 4px; color: #D97706; margin: 10px 0;">
      <% const fullStars = Math.round(stats.avgRating || 5); %>
      <% for(let i = 1; i <= 5; i++) { %>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="<%= i <= fullStars ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
      <% } %>
    </div>
    <span style="font-size: 0.8rem; color: var(--md-sys-color-on-surface-variant);">
      Dựa trên <strong><%= stats.totalReviews || 0 %></strong> lượt đánh giá món ăn
    </span>
  </div>

  <!-- Ratings Breakdown Card -->
  <div class="m3-bento-card" style="display: flex; flex-direction: column; justify-content: center; padding: 20px 24px;">
    <div style="font-size: 0.82rem; font-weight: 700; color: var(--md-sys-color-primary); margin-bottom: 12px;">
      PHÂN BỐ SỐ SAO ĐÁNH GIÁ
    </div>
    
    <% const total = stats.totalReviews || 1; %>
    <% const starRows = [
      { stars: 5, count: stats.count5 || 0 },
      { stars: 4, count: stats.count4 || 0 },
      { stars: 3, count: stats.count3 || 0 },
      { stars: 2, count: stats.count2 || 0 },
      { stars: 1, count: stats.count1 || 0 }
    ]; %>

    <div style="display: flex; flex-direction: column; gap: 8px;">
      <% starRows.forEach(row => { %>
        <% const pct = Math.round((row.count / total) * 100); %>
        <div style="display: flex; align-items: center; gap: 10px; font-size: 0.76rem;">
          <span style="width: 44px; font-weight: 700; color: var(--md-sys-color-primary);"><%= row.stars %> sao</span>
          <div style="flex: 1; height: 8px; background: var(--md-sys-color-surface-container-high); border-radius: 99px; overflow: hidden;">
            <div style="width: <%= pct %>%; height: 100%; background: #D97706; border-radius: 99px;"></div>
          </div>
          <span style="width: 50px; text-align: right; font-family: var(--font-mono); color: var(--md-sys-color-on-surface-variant);"><%= row.count %> (<%= pct %>%)</span>
        </div>
      <% }) %>
    </div>
  </div>
</div>

<!-- Filters Bar -->
<div class="kds-action-strip" style="margin-bottom: 20px;">
  <form method="GET" action="/admin/reviews" class="kds-filter-form-bar" style="width: 100%;">
    <div class="kds-select-field">
      <select name="branchId" onchange="this.form.submit()" class="m3-select-custom">
        <option value="">Tất Cả Chi Nhánh</option>
        <% if (branches && branches.length > 0) { %>
          <% branches.forEach(b => { %>
            <option value="<%= b._id %>" <%= String(currentBranch) === String(b._id) ? 'selected' : '' %>>
              [<%= b.district %>] <%= b.name %>
            </option>
          <% }) %>
        <% } %>
      </select>
    </div>

    <div class="kds-select-field">
      <select name="productId" onchange="this.form.submit()" class="m3-select-custom">
        <option value="">Tất Cả Thức Uống</option>
        <% if (products && products.length > 0) { %>
          <% products.forEach(p => { %>
            <option value="<%= p._id %>" <%= String(currentProduct) === String(p._id) ? 'selected' : '' %>>
              <%= p.name %>
            </option>
          <% }) %>
        <% } %>
      </select>
    </div>

    <div class="kds-select-field">
      <select name="rating" onchange="this.form.submit()" class="m3-select-custom">
        <option value="">Tất Cả Xếp Hạng</option>
        <option value="5" <%= currentRating === '5' ? 'selected' : '' %>>⭐⭐⭐⭐⭐ (5 sao)</option>
        <option value="4" <%= currentRating === '4' ? 'selected' : '' %>>⭐⭐⭐⭐ (4 sao)</option>
        <option value="3" <%= currentRating === '3' ? 'selected' : '' %>>⭐⭐⭐ (3 sao)</option>
        <option value="2" <%= currentRating === '2' ? 'selected' : '' %>>⭐⭐ (2 sao)</option>
        <option value="1" <%= currentRating === '1' ? 'selected' : '' %>>⭐ (1 sao)</option>
      </select>
    </div>

    <div class="kds-select-field">
      <select name="status" onchange="this.form.submit()" class="m3-select-custom">
        <option value="">Tất Cả Trạng Thái</option>
        <option value="visible" <%= currentStatus === 'visible' ? 'selected' : '' %>>Đang Hiển Thị</option>
        <option value="hidden" <%= currentStatus === 'hidden' ? 'selected' : '' %>>Đã Bị Ẩn (Vi phạm)</option>
      </select>
    </div>
  </form>
</div>

<!-- Reviews Table Card -->
<div class="m3-table-card">
  <div class="table-top-bar">
    <div>
      <h2 class="table-top-title">Danh Sách Nhận Xét (<%= reviews ? reviews.length : 0 %> phản hồi)</h2>
      <p class="table-top-caption">Quản trị viên có thể ẩn các đánh giá spam hoặc chứa từ ngữ không phù hợp</p>
    </div>
  </div>

  <div class="m3-table-wrapper">
    <table class="m3-table">
      <thead>
        <tr>
          <th style="width: 140px;">KHÁCH HÀNG</th>
          <th style="width: 180px;">MÓN ĂN</th>
          <th>CHI NHÁNH</th>
          <th style="width: 110px;">XẾP HẠNG</th>
          <th>NỘI DUNG NHẬN XÉT</th>
          <th style="width: 120px;">THỜI GIAN</th>
          <th style="width: 100px;">TRẠNG THÁI</th>
          <th style="text-align: center; width: 110px;">THAO TÁC</th>
        </tr>
      </thead>
      <tbody>
        <% if (reviews && reviews.length > 0) { %>
          <% reviews.forEach(rev => { %>
            <tr style="<%= rev.isHidden ? 'opacity: 0.65; background: #FFF5F5;' : '' %>">
              <td>
                <div style="font-weight: 700; color: var(--md-sys-color-primary); font-size: 0.85rem;">
                  <%= (rev.userId && rev.userId.fullName) || 'Khách Hàng' %>
                </div>
                <div style="font-size: 0.72rem; color: var(--md-sys-color-on-surface-variant);">
                  <%= (rev.userId && rev.userId.phone) || (rev.userId && rev.userId.email) || '' %>
                </div>
              </td>
              <td>
                <div style="display: flex; align-items: center; gap: 8px;">
                  <% if (rev.productId && rev.productId.imageUrl) { %>
                    <img src="<%= rev.productId.imageUrl %>" alt="<%= rev.productId.name %>" style="width: 32px; height: 32px; border-radius: 6px; object-fit: cover;">
                  <% } %>
                  <span style="font-weight: 600; font-size: 0.82rem; color: var(--md-sys-color-primary);">
                    <%= (rev.productId && rev.productId.name) || 'Món Ăn' %>
                  </span>
                </div>
              </td>
              <td>
                <span style="font-size: 0.76rem; color: var(--md-sys-color-on-surface-variant);">
                  <%= (rev.branchId && rev.branchId.name) || 'Toàn chuỗi' %>
                </span>
              </td>
              <td>
                <div style="display: flex; align-items: center; gap: 2px; color: #D97706;">
                  <% for(let s = 1; s <= 5; s++) { %>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="<%= s <= rev.rating ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                  <% } %>
                  <span style="font-family: var(--font-mono); font-weight: 700; font-size: 0.78rem; margin-left: 2px;">
                    <%= rev.rating %>.0
                  </span>
                </div>
              </td>
              <td>
                <div style="font-size: 0.84rem; color: var(--md-sys-color-on-surface);">
                  <%= rev.comment || '(Khách hàng không để lại nhận xét bằng chữ)' %>
                </div>
              </td>
              <td style="font-family: var(--font-mono); font-size: 0.74rem; color: var(--md-sys-color-on-surface-variant); white-space: nowrap;">
                <%= new Date(rev.createdAt).toLocaleDateString('vi-VN') %><br>
                <%= new Date(rev.createdAt).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) %>
              </td>
              <td>
                <span class="m3-badge <%= rev.isHidden ? 'badge-cancelled' : 'badge-ready' %>">
                  <%= rev.isHidden ? 'Đã Ẩn' : 'Hiển Thị' %>
                </span>
              </td>
              <td style="text-align: center;">
                <form action="/admin/reviews/<%= rev._id %>/toggle" method="POST" style="margin: 0;">
                  <button type="submit" class="stock-toggle-btn <%= rev.isHidden ? 'out-stock' : 'in-stock' %>" style="padding: 4px 10px; font-size: 0.72rem;">
                    <%= rev.isHidden ? 'Mở Hiện' : 'Ẩn Bài' %>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="8" style="text-align: center; padding: 36px; color: var(--md-sys-color-on-surface-variant);">
              Không tìm thấy đánh giá nào phù hợp với bộ lọc hiện tại.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
