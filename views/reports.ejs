<%- include('partials/header') %>

<!-- Island Header -->
<div class="island-header-bar">
  <div class="island-title-block">
    <div class="island-category-badge">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
      <span>ĐỐI SOÁT TÀI CHÍNH CA</span>
    </div>
    <h1 class="island-heading">Đối Soát Ca & Doanh Thu Quầy</h1>
    <p class="island-description">Kiểm soát dòng tiền mặt tại quầy, thanh toán điện tử và chiết khấu voucher theo ca làm việc.</p>
  </div>

  <div class="island-actions-group">
    <a href="/admin/reports/export?branchId=<%= selectedBranchId %>&date=<%= reportDate %>" class="m3-btn m3-btn-filled">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
      <span>Xuất Báo Cáo CSV (Slot 12)</span>
    </a>
  </div>
</div>

<!-- Shift Filter Controls Bar -->
<div class="kds-action-strip" style="margin-bottom: 24px;">
  <form method="GET" action="/admin/reports" class="kds-filter-form-bar" style="width: 100%;">
    <div class="kds-select-field">
      <label style="font-size: 0.72rem; font-weight: 700; color: var(--md-sys-color-primary); margin-right: 6px;">CHI NHÁNH:</label>
      <select name="branchId" onchange="this.form.submit()" class="m3-select-custom">
        <% if (branches && branches.length > 0) { %>
          <% branches.forEach(b => { %>
            <option value="<%= b._id %>" <%= String(selectedBranchId) === String(b._id) ? 'selected' : '' %>>
              [<%= b.district %>] <%= b.name %>
            </option>
          <% }) %>
        <% } %>
      </select>
    </div>

    <div class="kds-select-field">
      <label style="font-size: 0.72rem; font-weight: 700; color: var(--md-sys-color-primary); margin-right: 6px;">NGÀY ĐỐI SOÁT:</label>
      <input type="date" name="date" value="<%= reportDate %>" onchange="this.form.submit()" class="m3-text-input" style="padding: 6px 12px; height: 38px; width: auto;">
    </div>

    <button type="submit" class="m3-btn m3-btn-tonal" style="height: 38px; padding: 0 16px;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <span>Xem Dữ Liệu</span>
    </button>
  </form>
</div>

<!-- Bento Financial Metrics Grid -->
<div class="m3-bento-grid" style="margin-bottom: 20px;">
  <!-- Total Revenue -->
  <div class="m3-bento-card bento-accent-espresso">
    <div class="bento-card-top">
      <div class="bento-icon-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
      </div>
      <span class="bento-label">TỔNG DOANH THU CA</span>
    </div>
    <div class="bento-value-block">
      <div class="bento-number"><%= (stats.totalRevenue || 0).toLocaleString('vi-VN') %><span class="bento-unit">đ</span></div>
    </div>
    <div class="bento-footnote">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
      <span>Đơn hàng đã hoàn tất (Completed)</span>
    </div>
  </div>

  <!-- Cash at Counter -->
  <div class="m3-bento-card">
    <div class="bento-card-top">
      <div class="bento-icon-box" style="background: var(--md-sys-color-primary-container); color: var(--md-sys-color-primary);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
      </div>
      <span class="bento-label">TIỀN MẶT TẠI QUẦY (CASH)</span>
    </div>
    <div class="bento-value-block">
      <div class="bento-number"><%= (stats.cashRevenue || 0).toLocaleString('vi-VN') %><span class="bento-unit">đ</span></div>
    </div>
    <div class="bento-footnote">
      <span>Đối soát với két tiền Barista</span>
    </div>
  </div>

  <!-- Digital Payments -->
  <div class="m3-bento-card">
    <div class="bento-card-top">
      <div class="bento-icon-box" style="background: var(--md-sys-color-tertiary-container); color: var(--md-sys-color-tertiary);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
      </div>
      <span class="bento-label">CHUYỂN KHOẢN & VÍ MOMO</span>
    </div>
    <div class="bento-value-block">
      <div class="bento-number"><%= (stats.digitalRevenue || 0).toLocaleString('vi-VN') %><span class="bento-unit">đ</span></div>
    </div>
    <div class="bento-footnote">
      <span>Tài khoản PayOS & MoMo chuỗi</span>
    </div>
  </div>

  <!-- Voucher Discount -->
  <div class="m3-bento-card">
    <div class="bento-card-top">
      <div class="bento-icon-box" style="background: var(--md-sys-color-secondary-container); color: var(--md-sys-color-secondary);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line></svg>
      </div>
      <span class="bento-label">TỔNG CHIẾT KHẤU VOUCHER</span>
    </div>
    <div class="bento-value-block">
      <div class="bento-number" style="color: #991B1B;">-<%= (stats.discountTotal || 0).toLocaleString('vi-VN') %><span class="bento-unit">đ</span></div>
    </div>
    <div class="bento-footnote">
      <span>Khuyến mãi kích cầu đơn hàng</span>
    </div>
  </div>
</div>

<!-- Order Volume Breakdown Card -->
<div class="upload-artisan-card" style="margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
  <div>
    <div style="font-weight: 800; font-size: 0.95rem; color: var(--md-sys-color-primary);">
      THỐNG KÊ LƯU LƯỢNG VÉ PHA CHẾ
    </div>
    <div style="font-size: 0.74rem; color: var(--md-sys-color-on-surface-variant); margin-top: 2px;">
      Chi nhánh: <strong><%= selectedBranch ? selectedBranch.name : 'Đà Nẵng' %></strong> • Ngày: <strong><%= reportDate %></strong>
    </div>
  </div>

  <div style="display: flex; gap: 12px; flex-wrap: wrap;">
    <div class="status-summary-chip chip-all">
      Tổng: <strong><%= stats.totalOrders || 0 %></strong>
    </div>
    <div class="status-summary-chip chip-ready">
      Hoàn tất: <strong><%= stats.completedOrders || 0 %></strong>
    </div>
    <div class="status-summary-chip chip-prep">
      Đang xử lý: <strong><%= stats.processingOrders || 0 %></strong>
    </div>
    <div class="status-summary-chip chip-cancelled">
      Đã hủy: <strong><%= stats.cancelledOrders || 0 %></strong>
    </div>
  </div>
</div>

<!-- Shift Orders Master Table Card -->
<div class="m3-table-card">
  <div class="table-top-bar">
    <div>
      <h2 class="table-top-title">Chi Tiết Hóa Đơn Trong Ca (<%= orders ? orders.length : 0 %> đơn)</h2>
      <p class="table-top-caption">Dữ liệu nguồn phục vụ đối chiếu công nợ và sổ quỹ tiền mặt cuối ngày</p>
    </div>
  </div>

  <div class="m3-table-wrapper">
    <table class="m3-table">
      <thead>
        <tr>
          <th>MÃ ĐƠN</th>
          <th>KHÁCH HÀNG</th>
          <th>HẸN LẤY</th>
          <th>THANH TOÁN</th>
          <th>TRẠNG THÁI</th>
          <th style="text-align: right;">TẠM TÍNH</th>
          <th style="text-align: right;">VOUCHER</th>
          <th style="text-align: right;">THỰC THU</th>
          <th style="text-align: center;">HÓA ĐƠN</th>
        </tr>
      </thead>
      <tbody>
        <% if (orders && orders.length > 0) { %>
          <% orders.forEach(o => { %>
            <tr>
              <td>
                <span style="font-family: var(--font-mono); font-weight: 800; font-size: 0.82rem; color: var(--md-sys-color-primary);">
                  <%= o.orderCode %>
                </span>
                <div style="font-size: 0.7rem; color: var(--md-sys-color-on-surface-variant);">
                  <%= new Date(o.createdAt).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) %>
                </div>
              </td>
              <td>
                <div style="font-weight: 700; color: var(--md-sys-color-primary); font-size: 0.84rem;">
                  <%= (o.userId && o.userId.fullName) || 'Khách Vãng Lai' %>
                </div>
                <div style="font-size: 0.72rem; color: var(--md-sys-color-on-surface-variant);">
                  <%= (o.userId && o.userId.phone) || '' %>
                </div>
              </td>
              <td>
                <span class="m3-badge badge-pending" style="font-size: 0.72rem;">
                  <%= o.pickupTime || '15_MINS' %>
                </span>
              </td>
              <td>
                <div style="font-size: 0.78rem; font-weight: 700; color: <%= o.paymentMethod === 'CASH_AT_COUNTER' ? 'var(--md-sys-color-primary)' : 'var(--md-sys-color-tertiary)' %>;">
                  <%= o.paymentMethod === 'CASH_AT_COUNTER' ? 'Tiền Mặt Quầy' : o.paymentMethod %>
                </div>
                <span class="m3-badge <%= o.paymentStatus === 'PAID' ? 'badge-ready' : 'badge-prep' %>" style="font-size: 0.68rem; margin-top: 2px;">
                  <%= o.paymentStatus %>
                </span>
              </td>
              <td>
                <span class="m3-badge <%= o.status === 'Completed' ? 'badge-ready' : (o.status === 'Cancelled' ? 'badge-cancelled' : 'badge-prep') %>">
                  <%= o.status %>
                </span>
              </td>
              <td style="text-align: right; font-family: var(--font-mono); font-size: 0.82rem;">
                <%= (o.subtotal || 0).toLocaleString('vi-VN') %>đ
              </td>
              <td style="text-align: right; font-family: var(--font-mono); font-size: 0.82rem; color: #991B1B;">
                <%= o.discount ? '-' + o.discount.toLocaleString('vi-VN') + 'đ' : '0đ' %>
              </td>
              <td style="text-align: right; font-family: var(--font-mono); font-weight: 800; font-size: 0.88rem; color: var(--md-sys-color-primary);">
                <%= (o.totalAmount || 0).toLocaleString('vi-VN') %>đ
              </td>
              <td style="text-align: center;">
                <a href="/admin/orders/<%= o._id %>/invoice" class="action-mini-btn" title="Tải Hóa Đơn PDF/TXT (Slot 12)">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                </a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="9" style="text-align: center; padding: 36px; color: var(--md-sys-color-on-surface-variant);">
              Không có đơn hàng nào phát sinh trong ngày đối soát được chọn.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
