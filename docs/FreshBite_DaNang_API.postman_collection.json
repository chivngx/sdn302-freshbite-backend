    {
      "name": "2. Branches - Da Nang Stores",
      "item": [
        {
          "name": "2.1. Get All Da Nang Branches",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.length > 0) {",
                  "    pm.environment.set(\"branchId\", jsonData.data[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/branches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "branches"
              ]
            }
          }
        },
        {
          "name": "2.2. Filter Branches by District",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/branches?district=Ngũ Hành Sơn",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "branches"
              ],
              "query": [
