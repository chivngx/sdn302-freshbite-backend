              "raw": "{\n  \"branchId\": \"661a3b8e72c84a001a123456\",\n  \"pickupTime\": \"In 15 minutes (08:45)\",\n  \"paymentMethod\": \"CASH_AT_COUNTER\",\n  \"items\": [\n    {\n      \"productId\": \"661a3b8e72c84a001a123478\",\n      \"quantity\": 2,\n      \"price\": 32000,\n      \"sugarLevel\": \"50%\",\n      \"iceLevel\": \"50%\",\n      \"note\": \"Separate ice cup please\"\n    }\n  ]\n}"
