        {
          "name": "2.3 Tải Hóa Đơn Bán Lẻ Đơn Hàng (GET /api/uploads/orders/:id/invoice)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Invoice download attachment verified\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Disposition\")).to.include(\"attachment\");",
                  "    pm.expect(pm.response.text()).to.include(\"FRESHBITE\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/uploads/orders/{{orderId}}/invoice",
              "host": ["{{baseUrl}}"],
              "path": ["api", "uploads", "orders", "{{orderId}}", "invoice"]
            }
          }
        },
        {
          "name": "2.4 Tải Hóa Đơn Bán Lẻ RESTful (GET /api/orders/:id/invoice)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Content-Disposition header present\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Disposition\")).to.include(\"attachment\");",
                  "});"
