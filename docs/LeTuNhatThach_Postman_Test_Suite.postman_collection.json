{
  "info": {
    "_postman_id": "freshbite-letunhatthach-uploads-ssr",
    "name": "FreshBite - Le Tu Nhat Thach (Uploads, Seed Data & Web Admin SSR) Test Suite",
    "description": "Bộ kịch bản kiểm thử Postman toàn diện dành cho Lê Tự Nhật Thạch (Uploads, Seed Data & Web Admin SSR - 20% Scope môn SDN302 ĐH FPT)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "uploadedFilename",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "branchId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Khởi Tạo & Xác Thực (Setup & Auth)",
      "item": [
        {
          "name": "0.1 Đăng nhập Quản trị viên (Admin Login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "    pm.collectionVariables.set(\"adminToken\", json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@freshbite.vn\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "0.2 Lấy danh sách đơn hàng để trích xuất Order ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.length > 0) {",
                  "    pm.collectionVariables.set(\"orderId\", json.data[0]._id);",
                  "    if (json.data[0].branchId) {",
                  "        const bId = typeof json.data[0].branchId === 'object' ? json.data[0].branchId._id : json.data[0].branchId;",
                  "        pm.collectionVariables.set(\"branchId\", bId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/admin/all",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "admin", "all"]
            }
          }
        },
        {
          "name": "0.3 Lấy danh sách món ăn để trích xuất Product ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.length > 0) {",
                  "    pm.collectionVariables.set(\"productId\", json.data[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Multer File Upload Module (Slot 12)",
      "item": [
        {
          "name": "1.1 Upload 1 Ảnh Đơn Lẻ (POST /api/uploads/single)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test(\"Upload returns URL and filename\", function () {",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.url).to.include('/uploads/');",
                  "});",
                  "if (json.data && json.data.filename) {",
                  "    pm.collectionVariables.set(\"uploadedFilename\", json.data.filename);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/uploads/single",
              "host": ["{{baseUrl}}"],
              "path": ["api", "uploads", "single"]
            }
          }
        },
        {
          "name": "1.2 Tải Trực Tiếp Ảnh Tĩnh từ Express Static (GET /uploads/:filename)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/uploads/{{uploadedFilename}}",
              "host": ["{{baseUrl}}"],
              "path": ["uploads", "{{uploadedFilename}}"]
            }
          }
        },
        {
          "name": "1.3 Upload Ảnh Qua Route Alias (POST /api/uploads)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
