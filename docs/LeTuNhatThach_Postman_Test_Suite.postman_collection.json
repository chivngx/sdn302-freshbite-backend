              "raw": "{{baseUrl}}/api/uploads",
              "host": ["{{baseUrl}}"],
              "path": ["api", "uploads"]
            }
          }
        },
        {
          "name": "1.4 Upload Nhiều Ảnh Cùng Lúc (POST /api/uploads/multiple)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "images",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/uploads/multiple",
              "host": ["{{baseUrl}}"],
              "path": ["api", "uploads", "multiple"]
            }
          }
        },
        {
          "name": "1.5 Bắt Lỗi Khi Không Đính Kèm File (Validation Error)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test(\"Returns validation error message\", function () {",
                  "    pm.expect(json.success).to.be.false;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": []
            },
            "url": {
              "raw": "{{baseUrl}}/api/uploads/single",
              "host": ["{{baseUrl}}"],
              "path": ["api", "uploads", "single"]
            }
          }
        }
      ]
    },
    {
      "name": "2. File Download Module với res.download() (Slot 12)",
      "item": [
        {
          "name": "2.1 Tải Tệp Tin Đã Upload Bằng res.download() (GET /api/uploads/download/:filename)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Header Content-Disposition is attachment\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Disposition\")).to.include(\"attachment\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/uploads/download/{{uploadedFilename}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "uploads", "download", "{{uploadedFilename}}"]
            }
          }
        },
        {
          "name": "2.2 Tải Tệp Tin Mẫu CSV Thực Đơn (GET /api/uploads/template/product-import)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Downloads CSV file with attachment header\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Disposition\")).to.include(\"attachment\");",
                  "    pm.expect(pm.response.text()).to.include(\"categoryCode\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/uploads/template/product-import",
              "host": ["{{baseUrl}}"],
              "path": ["api", "uploads", "template", "product-import"]
