          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}/invoice",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{orderId}}", "invoice"]
            }
          }
        },
        {
          "name": "2.5 Báo Lỗi 404 Khi Tải Tệp Tin Không Tồn Tại",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/uploads/download/nonexistent_file_9999.png",
              "host": ["{{baseUrl}}"],
              "path": ["api", "uploads", "download", "nonexistent_file_9999.png"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Server-Side Rendering EJS Web Admin & Barista KDS (Slot 7)",
      "item": [
        {
          "name": "3.1 Truy Cập Bảng Quản Trị SSR (GET /admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Content-Type is text/html\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/html\");",
                  "});",
                  "pm.test(\"HTML contains Dashboard content\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"Bảng Quản Trị & Doanh Thu Quầy\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin",
              "host": ["{{baseUrl}}"],
              "path": ["admin"]
            }
          }
        },
        {
          "name": "3.2 Truy Cập Màn Hình KDS Quầy Barista (GET /admin/orders)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"HTML contains KDS elements\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"Màn Hình Quầy Barista (KDS)\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/orders",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "orders"]
            }
          }
        },
        {
          "name": "3.3 Lọc Đơn Hàng Theo Chi Nhánh Trên KDS (GET /admin/orders?branchId=...)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/orders?branchId={{branchId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "orders"],
              "query": [
                {
                  "key": "branchId",
                  "value": "{{branchId}}"
                }
              ]
            }
          }
        },
        {
          "name": "3.4 Cập Nhật Trạng Thái Đơn Hàng Từ Web Admin SSR (POST /admin/orders/:id/status)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 302 Redirect\", function () {",
                  "    pm.expect([200, 302]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "status",
                  "value": "Preparing",
                  "type": "text"
                },
                {
                  "key": "redirectUrl",
                  "value": "/admin/orders",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/admin/orders/{{orderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "orders", "{{orderId}}", "status"]
            }
          }
        },
