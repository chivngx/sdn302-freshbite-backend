              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Message created with senderRole customer\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.senderRole).to.eql(\"customer\");",
                  "    pm.expect(jsonData.data.isRead).to.eql(false);",
                  "    pm.expect(jsonData.data.content).to.be.a('string');",
                  "});"
