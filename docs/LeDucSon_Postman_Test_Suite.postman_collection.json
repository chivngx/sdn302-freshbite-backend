        {
          "name": "01. Login Customer (Le Duc Son)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Extract and save customer token & id\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "    pm.collectionVariables.set(\"customerToken\", jsonData.token);",
                  "    if (jsonData.data && jsonData.data._id) {",
                  "        pm.collectionVariables.set(\"customerId\", jsonData.data._id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
